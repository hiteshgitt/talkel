# apps/api — copy to .env and fill in. Never commit .env.
PORT=4810

# ── Core (Milestone 1) ──
DATABASE_URL=postgresql://speakai:speakai_dev@localhost:5436/speakai
# Public URL of this API as phones/browsers reach it (email links, OAuth redirects)
APP_BASE_URL=http://192.168.1.40:4810
# Web app origin (sign-in pages, dashboard)
WEB_BASE_URL=http://192.168.1.40:3100
MOBILE_SCHEME=speakai
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# Job queue (after-call analysis) — Redis from docker-compose
REDIS_URL=redis://localhost:6381
# After-call evaluation models, most preferred first (fallbacks when one is overloaded)
EVAL_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest

# Optional: Google sign-in (Google Cloud Console → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev: Mailpit from docker-compose (web UI http://localhost:8027). Empty = emails are logged.
SMTP_URL=smtp://localhost:1027
EMAIL_FROM=Talkel <no-reply@talkel.local>

# Which realtime voice provider runs calls: gemini (default) | openai
REALTIME_PROVIDER=gemini

# Gemini Live (gemini mode): phone ⇄ this server (WebRTC) ⇄ Gemini (WebSocket)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# STUN/TURN for the server-side WebRTC endpoint (comma-separated)
RTC_ICE_SERVERS=stun:stun.l.google.com:19302
# UDP ports for call audio (open these in the firewall): min-max
RTC_UDP_PORT_RANGE=40000-40099

# OpenAI (server-side only; never shipped to the mobile app).
# Leave empty to boot without a provider: /v1/poc/connect then returns 503 PROVIDER_NOT_CONFIGURED.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_TRANSCRIBE_MODEL=gpt-transcribe

# Optional: static token for headless test scripts on the voice routes (scripts/spike-call.ts). Min 16 chars.
# Generate one with: openssl rand -hex 24
POC_DEV_TOKEN=

# Daily free conversation time per user (seconds) and the cap for a single conversation
FREE_DAILY_SECONDS=600
CONVERSATION_MAX_SECONDS=1800

# Where per-call JSONL event logs are written (latency/transcript analysis for the M0 report).
CALL_LOG_DIR=./logs/calls

# ── Production (Cloud Run) — see docs/DEPLOY.md ──
# RESEND_API_KEY=            # email via Resend when SMTP_URL is empty
# RUN_WORKER_IN_API=true     # one always-on service runs the analysis worker too
# RTC_RELAY_ONLY=true        # media only via TURN (Cloud Run has no inbound UDP)
# TURN_KEY_ID= / TURN_KEY_API_TOKEN=   # Cloudflare Realtime TURN key
# R2_ACCOUNT_ID= / R2_ACCESS_KEY_ID= / R2_SECRET_ACCESS_KEY= / R2_BUCKET=   # recordings in Cloudflare R2
