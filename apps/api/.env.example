# apps/api — copy to .env and fill in. Never commit .env.
PORT=4810

# OpenAI (server-side only; never shipped to the mobile app).
# Leave empty to boot without a provider: /v1/poc/connect then returns 503 PROVIDER_NOT_CONFIGURED.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_TRANSCRIBE_MODEL=gpt-transcribe

# Milestone 0 only: static bearer token the POC mobile build sends. Min 16 chars.
# Generate one with: openssl rand -hex 24
POC_DEV_TOKEN=

# Hard cap per POC call (server-enforced).
POC_MAX_SESSION_SECONDS=300

# Where per-call JSONL event logs are written (latency/transcript analysis for the M0 report).
CALL_LOG_DIR=./logs/calls
