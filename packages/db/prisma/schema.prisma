// SpeakAI database schema (Prisma ORM 7). See docs/DATABASE.md for the full design;
// tables are added milestone by milestone. M1: identity, profile, settings.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  // The package is compiled with tsc (NodeNext), so generated imports need .js extensions.
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Identity (Better Auth core tables) ─────────────
// Field names follow Better Auth's core schema; do not rename without updating the auth config.

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  /// "user" | "admin". Server-owned: Better Auth is configured with input: false.
  role          String   @default("user")
  /// "FREE" | "PRO". Server-owned; decides entitlements such as choosing the partner and accent.
  plan          String   @default("FREE")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  settings      UserSettings?
  conversations ConversationSession[]
  usageRecords  UsageRecord[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  /// Password hash for the "credential" provider. Never plaintext.
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// ───────────── Profile & settings ─────────────

enum EnglishLevel {
  BEGINNER
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
  EXPERT
}

enum AudioRetention {
  NONE
  SESSION_ONLY
  DAYS_30
}

enum VoiceGender {
  FEMALE
  MALE
  NEUTRAL
}

model Profile {
  userId            String        @id @db.Uuid
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String?
  /// BCP-47, e.g. "hi", "mr", "ta"
  nativeLanguage    String?
  selfReportedLevel EnglishLevel?
  /// e.g. ["interviews", "work_meetings"] — values validated by @speakai/contracts
  goals             String[]      @default([])
  timezone          String        @default("Asia/Kolkata")
  onboardedAt       DateTime?     @db.Timestamptz(3)
  /// Consent to voice processing and transcript storage (India DPDP Act). Version of the notice agreed to.
  consentVersion    String?
  consentedAt       DateTime?     @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  @@map("profiles")
}

model UserSettings {
  userId               String         @id @db.Uuid
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Language for feedback explanations: "en" | "hi" in the MVP. Conversations are always English.
  feedbackLanguage     String         @default("en")
  liveCorrection       Boolean        @default(false)
  audioRetention       AudioRetention @default(NONE)
  defaultDifficulty    EnglishLevel   @default(INTERMEDIATE)
  defaultDurationSec   Int            @default(600)
  preferredVoiceGender VoiceGender?
  notificationsEnabled Boolean        @default(true)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)

  @@map("user_settings")
}

// ───────────── Content: scenarios & personas (M2) ─────────────
// Published scenario versions are immutable; sessions pin the exact version they used (PRD §78).

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ScenarioCategory {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String     @unique
  name      String
  sortOrder Int        @default(0)
  scenarios Scenario[]

  @@map("scenario_categories")
}

model Scenario {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String            @unique
  categoryId         String            @db.Uuid
  category           ScenarioCategory  @relation(fields: [categoryId], references: [id])
  isActive           Boolean           @default(false)
  sortOrder          Int               @default(0)
  publishedVersionId String?           @unique @db.Uuid
  publishedVersion   ScenarioVersion?  @relation("Published", fields: [publishedVersionId], references: [id])
  versions           ScenarioVersion[] @relation("Versions")
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  @@map("scenarios")
}

model ScenarioVersion {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scenarioId       String        @db.Uuid
  scenario         Scenario      @relation("Versions", fields: [scenarioId], references: [id])
  version          Int
  status           ContentStatus @default(DRAFT)
  /// Selects the params schema and engine behaviour: casual | interview | client | debate | negotiation
  kind             String
  title            String
  /// One line for lists
  tagline          String
  /// Shown to the user before the call (PRD §24) — never the AI's questions
  briefing         String
  userRole         String
  objective        String
  minLevel         EnglishLevel  @default(BEGINNER)
  estimatedMinutes Int           @default(5)
  /// Scenario layer of the AI instructions
  promptTemplate   String
  /// Per-kind parameters (validated by the engine); may contain hidden values like a floor price
  params           Json
  /// [{ id, description }]
  goals            Json
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  publishedAt      DateTime?     @db.Timestamptz(3)

  publishedFor Scenario?             @relation("Published")
  sessions     ConversationSession[]

  @@unique([scenarioId, version])
  @@map("scenario_versions")
}

model Persona {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String                @unique
  name           String
  gender         VoiceGender
  /// Provider voice ids, e.g. { "gemini": "Kore", "openai": "marin" }
  voices         Json
  /// Short personality/background shown in the app
  description    String
  /// Persona layer of the AI instructions
  promptFragment String
  isActive       Boolean               @default(true)
  sortOrder      Int                   @default(0)
  version        Int                   @default(1)
  sessions       ConversationSession[]

  @@map("personas")
}

// ───────────── Conversations (M2) ─────────────

enum SessionStatus {
  CREATED
  CONNECTING
  ACTIVE
  RECONNECTING
  ENDED
  FAILED
  EXPIRED
}

enum EndReason {
  USER_ENDED
  TIME_LIMIT
  OBJECTIVE_COMPLETED
  AI_NATURAL_END
  CONNECTION_LOST
  PROVIDER_CLOSED
  QUOTA_EXHAUSTED
  SERVER_RESTART
  ERROR
}

enum Speaker {
  USER
  AI
}

model ConversationSession {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String          @db.Uuid
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioVersionId   String          @db.Uuid
  scenarioVersion     ScenarioVersion @relation(fields: [scenarioVersionId], references: [id])
  personaId           String          @db.Uuid
  persona             Persona         @relation(fields: [personaId], references: [id])
  difficulty          EnglishLevel
  liveCorrection      Boolean         @default(false)
  /// AMERICAN | BRITISH | INDIAN | AUSTRALIAN — best-effort accent hint for the AI voice
  accent              String          @default("INDIAN")
  plannedDurationSec  Int
  status              SessionStatus   @default(CREATED)
  endReason           EndReason?
  startedAt           DateTime?       @db.Timestamptz(3)
  endedAt             DateTime?       @db.Timestamptz(3)
  durationMs          Int?
  /// Reproducibility (PRD §78): provider/model, prompt layer versions, persona version
  provider            String
  model               String
  promptVersions      Json
  instructionsHash    String
  /// Randomised per session (topic, item, prices…) plus live updates from tools
  scenarioState       Json
  goalsAchieved       String[]        @default([])
  /// Optional user-started call recording (both voices, Ogg Opus): key in the recordings store
  recordingKey        String?
  recordingDurationMs Int?
  recordingBytes      Int?
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)

  turns  ConversationTurn[]
  events ConversationEvent[]
  usage  UsageRecord[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("conversation_sessions")
}

model ConversationTurn {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String              @db.Uuid
  session     ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq         Int
  speaker     Speaker
  text        String
  /// Offset from call start
  startMs     Int
  interrupted Boolean             @default(false)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([sessionId, seq])
  @@map("conversation_turns")
}

model ConversationEvent {
  id        BigInt              @id @default(autoincrement())
  sessionId String              @db.Uuid
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// STARTED, READY, TOOL_CALL, WRAP_UP, RECONNECTED, MEDIA_STATS, ENDED, ERROR …
  type      String
  atMs      Int
  payload   Json?
  createdAt DateTime            @default(now()) @db.Timestamptz(3)

  @@index([sessionId, atMs])
  @@map("conversation_events")
}

enum UsageKind {
  REALTIME
  EVALUATION
  TRANSCRIPTION
}

model UsageRecord {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @db.Uuid
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId         String?              @db.Uuid
  session           ConversationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  kind              UsageKind
  provider          String
  model             String
  /// Seconds of conversation counted against the daily limit
  billableSeconds   Int                  @default(0)
  inputAudioTokens  Int                  @default(0)
  outputAudioTokens Int                  @default(0)
  inputTextTokens   Int                  @default(0)
  outputTextTokens  Int                  @default(0)
  cachedInputTokens Int                  @default(0)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("usage_records")
}
