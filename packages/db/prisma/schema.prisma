// SpeakAI database schema (Prisma ORM 7). See docs/DATABASE.md for the full design;
// tables are added milestone by milestone. M1: identity, profile, settings.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  // The package is compiled with tsc (NodeNext), so generated imports need .js extensions.
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Identity (Better Auth core tables) ─────────────
// Field names follow Better Auth's core schema; do not rename without updating the auth config.

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  /// "user" | "admin". Server-owned: Better Auth is configured with input: false.
  role          String   @default("user")
  /// "FREE" | "PRO". Server-owned; decides entitlements such as choosing the partner and accent.
  plan          String   @default("FREE")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  sessions        Session[]
  accounts        Account[]
  profile         Profile?
  settings        UserSettings?
  conversations   ConversationSession[]
  usageRecords    UsageRecord[]
  learningProfile LearningProfile?
  grammarErrors   GrammarError[]
  vocabularyItems VocabularyItem[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  /// Password hash for the "credential" provider. Never plaintext.
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// ───────────── Profile & settings ─────────────

enum EnglishLevel {
  BEGINNER
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
  EXPERT
}

enum AudioRetention {
  NONE
  SESSION_ONLY
  DAYS_30
}

enum VoiceGender {
  FEMALE
  MALE
  NEUTRAL
}

model Profile {
  userId            String        @id @db.Uuid
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String?
  /// BCP-47, e.g. "hi", "mr", "ta"
  nativeLanguage    String?
  selfReportedLevel EnglishLevel?
  /// e.g. ["interviews", "work_meetings"] — values validated by @speakai/contracts
  goals             String[]      @default([])
  timezone          String        @default("Asia/Kolkata")
  onboardedAt       DateTime?     @db.Timestamptz(3)
  /// Consent to voice processing and transcript storage (India DPDP Act). Version of the notice agreed to.
  consentVersion    String?
  consentedAt       DateTime?     @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  @@map("profiles")
}

model UserSettings {
  userId               String         @id @db.Uuid
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Language for feedback explanations: "en" | "hi" in the MVP. Conversations are always English.
  feedbackLanguage     String         @default("en")
  liveCorrection       Boolean        @default(false)
  audioRetention       AudioRetention @default(NONE)
  defaultDifficulty    EnglishLevel   @default(INTERMEDIATE)
  defaultDurationSec   Int            @default(600)
  preferredVoiceGender VoiceGender?
  notificationsEnabled Boolean        @default(true)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)

  @@map("user_settings")
}

// ───────────── Content: scenarios & personas (M2) ─────────────
// Published scenario versions are immutable; sessions pin the exact version they used (PRD §78).

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ScenarioCategory {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String     @unique
  name      String
  sortOrder Int        @default(0)
  scenarios Scenario[]

  @@map("scenario_categories")
}

model Scenario {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String            @unique
  categoryId         String            @db.Uuid
  category           ScenarioCategory  @relation(fields: [categoryId], references: [id])
  isActive           Boolean           @default(false)
  sortOrder          Int               @default(0)
  publishedVersionId String?           @unique @db.Uuid
  publishedVersion   ScenarioVersion?  @relation("Published", fields: [publishedVersionId], references: [id])
  versions           ScenarioVersion[] @relation("Versions")
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  @@map("scenarios")
}

model ScenarioVersion {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scenarioId       String        @db.Uuid
  scenario         Scenario      @relation("Versions", fields: [scenarioId], references: [id])
  version          Int
  status           ContentStatus @default(DRAFT)
  /// Selects the params schema and engine behaviour: casual | interview | client | debate | negotiation
  kind             String
  title            String
  /// One line for lists
  tagline          String
  /// Shown to the user before the call (PRD §24) — never the AI's questions
  briefing         String
  userRole         String
  objective        String
  minLevel         EnglishLevel  @default(BEGINNER)
  estimatedMinutes Int           @default(5)
  /// Scenario layer of the AI instructions
  promptTemplate   String
  /// Per-kind parameters (validated by the engine); may contain hidden values like a floor price
  params           Json
  /// [{ id, description }]
  goals            Json
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  publishedAt      DateTime?     @db.Timestamptz(3)

  publishedFor Scenario?             @relation("Published")
  sessions     ConversationSession[]

  @@unique([scenarioId, version])
  @@map("scenario_versions")
}

model Persona {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String                @unique
  name           String
  gender         VoiceGender
  /// Provider voice ids, e.g. { "gemini": "Kore", "openai": "marin" }
  voices         Json
  /// Short personality/background shown in the app
  description    String
  /// Persona layer of the AI instructions
  promptFragment String
  isActive       Boolean               @default(true)
  sortOrder      Int                   @default(0)
  version        Int                   @default(1)
  sessions       ConversationSession[]

  @@map("personas")
}

// ───────────── Conversations (M2) ─────────────

enum SessionStatus {
  CREATED
  CONNECTING
  ACTIVE
  RECONNECTING
  ENDED
  FAILED
  EXPIRED
}

enum EndReason {
  USER_ENDED
  TIME_LIMIT
  OBJECTIVE_COMPLETED
  AI_NATURAL_END
  CONNECTION_LOST
  PROVIDER_CLOSED
  QUOTA_EXHAUSTED
  SERVER_RESTART
  ERROR
}

enum Speaker {
  USER
  AI
}

model ConversationSession {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String          @db.Uuid
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioVersionId   String          @db.Uuid
  scenarioVersion     ScenarioVersion @relation(fields: [scenarioVersionId], references: [id])
  personaId           String          @db.Uuid
  persona             Persona         @relation(fields: [personaId], references: [id])
  difficulty          EnglishLevel
  liveCorrection      Boolean         @default(false)
  /// AMERICAN | BRITISH | INDIAN | AUSTRALIAN — best-effort accent hint for the AI voice
  accent              String          @default("INDIAN")
  plannedDurationSec  Int
  status              SessionStatus   @default(CREATED)
  endReason           EndReason?
  startedAt           DateTime?       @db.Timestamptz(3)
  endedAt             DateTime?       @db.Timestamptz(3)
  durationMs          Int?
  /// Reproducibility (PRD §78): provider/model, prompt layer versions, persona version
  provider            String
  model               String
  promptVersions      Json
  instructionsHash    String
  /// Randomised per session (topic, item, prices…) plus live updates from tools
  scenarioState       Json
  goalsAchieved       String[]        @default([])
  /// Optional user-started call recording (both voices, Ogg Opus): key in the recordings store
  recordingKey        String?
  recordingDurationMs Int?
  recordingBytes      Int?
  /// After-call feedback (Milestone 3)
  analysisStatus      AnalysisStatus  @default(PENDING)
  /// Measured live: total user speech time and timing metrics (latencies, long pauses)
  userSpeakingMs      Int?
  liveMetrics         Json?
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)

  turns    ConversationTurn[]
  events   ConversationEvent[]
  usage    UsageRecord[]
  analysis SessionAnalysis?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("conversation_sessions")
}

model ConversationTurn {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String              @db.Uuid
  session     ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq         Int
  speaker     Speaker
  text        String
  /// Offset from call start
  startMs     Int
  interrupted Boolean             @default(false)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([sessionId, seq])
  @@map("conversation_turns")
}

model ConversationEvent {
  id        BigInt              @id @default(autoincrement())
  sessionId String              @db.Uuid
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// STARTED, READY, TOOL_CALL, WRAP_UP, RECONNECTED, MEDIA_STATS, ENDED, ERROR …
  type      String
  atMs      Int
  payload   Json?
  createdAt DateTime            @default(now()) @db.Timestamptz(3)

  @@index([sessionId, atMs])
  @@map("conversation_events")
}

enum UsageKind {
  REALTIME
  EVALUATION
  TRANSCRIPTION
}

model UsageRecord {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @db.Uuid
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId         String?              @db.Uuid
  session           ConversationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  kind              UsageKind
  provider          String
  model             String
  /// Seconds of conversation counted against the daily limit
  billableSeconds   Int                  @default(0)
  inputAudioTokens  Int                  @default(0)
  outputAudioTokens Int                  @default(0)
  inputTextTokens   Int                  @default(0)
  outputTextTokens  Int                  @default(0)
  cachedInputTokens Int                  @default(0)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("usage_records")
}

// ───────────── After-call feedback (M3) ─────────────

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum VocabKind {
  REPEATED
  UPGRADE
  GOOD_USAGE
}

model SessionAnalysis {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId           String              @unique @db.Uuid
  session             ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// 0–100, a multiple of 5, derived from skill bands (never the only feedback — PRD §27)
  overallScore        Int
  /// { grammar: { band, score, rationale, evidence[] }, … }
  skills              Json
  summary             String
  strengths           String[]
  focusAreas          String[]
  /// PRD §33 observations: asked questions, elaborated, disagreed politely, clarified
  conversationSkills  Json
  /// PRD §43: patterns suggesting word-for-word translation (phrased as patterns, never "you thought in Hindi")
  translationPatterns String[]
  feedbackLanguage    String
  evalModel           String
  evalPromptVersion   String
  /// Corrections dropped because they didn't match what the user actually said
  groundingDropped    Int                 @default(0)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)

  grammarErrors   GrammarError[]
  vocabularyItems VocabularyItem[]
  fluency         FluencyMetrics?
  recommendations PracticeRecommendation[]

  @@map("session_analyses")
}

model GrammarError {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisId  String          @db.Uuid
  analysis    SessionAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  /// Denormalised for "your common mistakes" queries across sessions
  userId      String          @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Transcript turn (seq) the mistake came from
  turnSeq     Int
  original    String
  corrected   String
  /// Controlled list (see the evaluation schema): PAST_TENSE, ARTICLES, …
  category    String
  explanation String
  severity    Severity
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  @@index([userId, category])
  @@map("grammar_errors")
}

model VocabularyItem {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisId   String          @db.Uuid
  analysis     SessionAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  userId       String          @db.Uuid
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         VocabKind
  term         String
  alternatives String[]
  example      String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  @@index([userId, kind])
  @@map("vocabulary_items")
}

model FluencyMetrics {
  analysisId         String          @id @db.Uuid
  analysis           SessionAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  userSpeakingMs     Int
  userTurns          Int
  userWords          Int
  wordsPerMinute     Int?
  meanUtteranceWords Float
  typeTokenRatio     Float
  /// { "um": 3, "like": 2 } — from the transcript (fillers may be under-counted, see VOICE-ARCHITECTURE §7)
  fillerCounts       Json
  fillersPerMinute   Float?
  latencyP50Ms       Int?
  latencyP90Ms       Int?
  longPauseCount     Int

  @@map("fluency_metrics")
}

model PracticeRecommendation {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisId   String          @db.Uuid
  analysis     SessionAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  /// SCENARIO | GRAMMAR_FOCUS | VOCABULARY | FLUENCY
  type         String
  scenarioSlug String?
  title        String
  reason       String
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  @@map("practice_recommendations")
}

/// Evolves after every analysed conversation (PRD §34); feeds the next conversation's learner layer (PRD §35).
model LearningProfile {
  userId                String   @id @db.Uuid
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Running averages of skill bands (1–5), recent sessions weighted more
  grammarBand           Float?
  vocabularyBand        Float?
  fluencyBand           Float?
  conversationBand      Float?
  /// [{ category, count, lastSeenAt }]
  commonErrors          Json     @default("[]")
  /// { "um": 12, … }
  commonFillers         Json     @default("{}")
  analysedCount         Int      @default(0)
  totalSpeakingMs       BigInt   @default(0)
  lastAnalysedSessionId String?  @db.Uuid
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@map("learning_profiles")
}
